# Variáveis de ambiente — COPIE para `.env` e preencha.
#
# §91: NUNCA commite o `.env`. Ele já está no `.gitignore`.
# §91: segredos server-side (service_role) NUNCA chegam ao cliente.
#
# A chave `SUPABASE_ANON_KEY` é segura para o navegador porque o acesso é
# protegido por RLS. A `SUPABASE_SERVICE_ROLE_KEY` NÃO é — ela contorna a
# RLS e só pode existir em ambiente de servidor.

# --- Frontend (público, seguro com RLS ativa) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend / CI (NUNCA expor em VITE_*) ---
# Sem o prefixo VITE_, o Vite não as injeta no bundle.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# --- Google OAuth ---
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel ---
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=

# --- Debug Mode (§93 — exclusivo de desenvolvimento) ---
# `true` habilita o painel de debug. NUNCA `true` em produção.
VITE_DEBUG_MODE=false
