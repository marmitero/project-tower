{
  "name": "@tia/game-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shell do jogo. Vite + React + Phaser. UI e render, nunca regra.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "assets:build": "node ../../scripts/build-assets.mjs",
    "build:preview": "vite build --mode preview --outDir preview"
  },
  "dependencies": {
    "@tia/config": "*",
    "@tia/contracts": "*",
    "@tia/engine": "*",
    "@tia/game-core": "*",
    "@tia/ui": "*",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
