{
  "name": "tower-idle-adventure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RPG 2D idle / auto-battle / loot para navegador. O jogador e o Rei.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tia/game-web",
    "build": "npm run build --workspace @tia/game-web",
    "preview": "npm run preview --workspace @tia/game-web",
    "test": "vitest run --project unit --project integration --project ui",
    "test:arch": "vitest run --project arch",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "check:config": "vitest run --project unit packages/config",
    "check:assets": "node scripts/check-assets.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "check:no-secret": "node scripts/check-no-secret.mjs",
    "check:debug-mode": "node scripts/check-debug-mode.mjs",
    "check": "npm run check:docs && npm run typecheck && npm run test && npm run test:arch && npm run check:assets && npm run check:no-secret && npm run check:debug-mode && npm run check:preview",
    "typecheck": "tsc --noEmit",
    "check:assets:strict": "node scripts/check-assets.mjs --strict",
    "verify": "npm run check && npm run build",
    "preview:static": "node scripts/serve-preview.mjs",
    "build:preview": "npm run build:preview -w @tia/game-web && node scripts/preview-info.mjs write",
    "report:balance": "vite-node --config vitest.config.ts scripts/balance-report.ts",
    "check:preview": "node scripts/check-preview.mjs",
    "art": "node scripts/art.mjs",
    "art:guide": "node scripts/art.mjs guide",
    "art:key": "node scripts/art.mjs key",
    "art:normalize": "node scripts/art.mjs normalize",
    "art:validate": "node scripts/art.mjs validate",
    "art:contact": "node scripts/art.mjs contact",
    "art:ingest": "node scripts/art.mjs ingest",
    "art:seamless": "node scripts/art.mjs seamless",
    "art:recolor": "node scripts/art.mjs recolor",
    "art:pack": "node scripts/art.mjs pack",
    "art:measure": "node scripts/art.mjs measure",
    "art:provenance": "node scripts/art.mjs provenance",
    "art:kit": "node scripts/art.mjs kit",
    "art:buttons": "node scripts/art.mjs buttons",
    "art:icons": "node scripts/art.mjs icons",
    "art:portraits": "node scripts/art.mjs portraits",
    "art:trim": "node scripts/art.mjs trim",
    "art:backdrop": "node scripts/art.mjs backdrop",
    "play": "node scripts/play.mjs",
    "play:debug": "npm run build:debug -w @tia/game-web && node scripts/play.mjs --debug"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
